NODE_ENV=development
PORT=3000

# PostgreSQL
# Use DATABASE_URL for a managed provider; otherwise use DB_HOST/PORT/etc.
# Supabase template: postgresql://sismarket_runtime.<PROJECT_REF>:[URL_ENCODED_PASSWORD]@[SESSION_POOLER_HOST]:5432/postgres
# For Supabase, set DB_SSL=true and DB_SSL_CA_CERT=./supabase-ca.crt. Do not add sslmode to DATABASE_URL.
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=sismarket
DB_PASSWORD=sismarket_secret
DB_DATABASE=sismarket
DB_SSL=false
DB_SSL_CA_CERT=
# Run schema migrations automatically in development. For RLS runtime roles, run them once with an owner URL, then set false.
DB_MIGRATIONS_RUN=true
# Enable per-request PostgreSQL tenant context when the connection role is subject to RLS.
DB_RLS_CONTEXT=true

# Supabase Auth (all service credentials stay in the backend)
SUPABASE_AUTH_ENABLED=false
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# JWT
JWT_SECRET=change-this-in-production-use-long-random-string
JWT_EXPIRES_IN=8h
APP_ENCRYPTION_KEY=replace-with-64-hexadecimal-characters-and-keep-this-stable

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# CORS
FRONTEND_URL=http://localhost:5173

# Gemini AI
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Nubefact electronic invoices
NUBEFACT_API_URL=
NUBEFACT_TOKEN=
NUBEFACT_AUTO_SEND=false
NUBEFACT_SEND_TO_SUNAT=false
NUBEFACT_SERIE_BOLETA=B001
NUBEFACT_SERIE_FACTURA=F001

# Culqi SaaS subscriptions (create one monthly plan per tier in the Culqi Panel)
CULQI_BILLING_PUBLIC_KEY=
CULQI_BILLING_SECRET_KEY=
CULQI_PLAN_BASICO=
CULQI_PLAN_ESTANDAR=
CULQI_PLAN_PREMIUM=
# Set this random URL secret in the Culqi webhook endpoint: /api/subscriptions/webhook/<secret>
CULQI_WEBHOOK_SECRET=

# Enable plan-based API restrictions in production after subscriptions are configured.
SUBSCRIPTION_ENFORCEMENT=false
