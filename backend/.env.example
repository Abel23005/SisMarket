NODE_ENV=development
PORT=3000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=sismarket
DB_PASSWORD=sismarket_secret
DB_DATABASE=sismarket

# JWT
JWT_SECRET=change-this-in-production-use-long-random-string
JWT_EXPIRES_IN=8h

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# CORS
FRONTEND_URL=http://localhost:5173

# Gemini AI
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# Nubefact electronic invoices
NUBEFACT_API_URL=https://api.nubefact.com/api/v1/replace-with-your-route
NUBEFACT_TOKEN=replace-with-your-token
NUBEFACT_AUTO_SEND=false
NUBEFACT_SEND_TO_SUNAT=false
NUBEFACT_SERIE_BOLETA=B001
